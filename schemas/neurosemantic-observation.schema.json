{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trinitywayve.dev/schemas/neurosemantic-observation-1.0.0.json",
  "title": "FRAME.9 synthetic neuro-semantic observation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "observationId",
    "sourceMode",
    "device",
    "observedAt",
    "modality",
    "sampleRateHz",
    "unit",
    "samples",
    "quality",
    "consent",
    "clinicalUse"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "observationId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "sourceMode": {
      "const": "synthetic"
    },
    "device": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deviceId",
        "deviceClass",
        "firmwareVersion"
      ],
      "properties": {
        "deviceId": {
          "type": "string",
          "minLength": 1
        },
        "deviceClass": {
          "const": "synthetic-neuro-signal-source"
        },
        "firmwareVersion": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "observedAt": {
      "type": "string",
      "format": "date-time"
    },
    "modality": {
      "const": "synthetic-electrophysiology"
    },
    "sampleRateHz": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 1000000
    },
    "unit": {
      "enum": [
        "uV",
        "mV",
        "V",
        "a.u."
      ]
    },
    "samples": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100000,
      "items": {
        "type": "number",
        "minimum": -1000000,
        "maximum": 1000000
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "snrDb"
      ],
      "properties": {
        "status": {
          "const": "simulated"
        },
        "snrDb": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    },
    "consent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "const": "not-applicable-synthetic"
        }
      }
    },
    "clinicalUse": {
      "const": "prohibited"
    }
  }
}
